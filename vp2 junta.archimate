      <child xsi:type="archimate:DiagramObject" id="id-2b58d572eebe40f3b6a729f0550ab5d7" targetConnections="id-c787a859516649c4a52887693fe7da04 id-ae76292b8bdd404ca3242960a825a8df" archimateElement="id-861fc9ea37644330bfe5a0caf22be475">
